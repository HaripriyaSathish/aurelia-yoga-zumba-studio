# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Database — leave blank to use local SQLite.
# Option A: single connection string
DATABASE_URL=
# Option B: individual PostgreSQL settings (used if DATABASE_URL is blank)
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (SMTP) — leave EMAIL_BACKEND as console backend for local dev
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AURELIA Yoga & Zumba Studio <studio@aureliawellness.com>
ADMIN_EMAIL=studio@aureliawellness.com
